	quest.1EB883EB9A8A3785.title: "Set up a &8Pumpjack&r | 搭建一台&8抽油机&r"
	quest.1EE4A5C43CE2B840.title: "&lEmpty Fan Catalyst | &l空风扇催化剂"
	quest.1F091A899BB5622B.quest_subtitle: "Now you will never die to a saw ever again | 现在你再也不会被锯子杀死了"
	quest.1F091A899BB5622B.title: "&d&lTotem of Undying | &d&l不死图腾"
