	quest.5B1153E41E67209F.quest_desc: [
		"For our last step we will use a &6Spout filled with lava&r and fill up our &cBlaze core&r that's dropped onto a Depot underneath the Spout."
		"最后一步，我们将使用&6装满岩浆的注液器&r，为注液器下方置物台上投放的&c烈焰核心&r加注"
	]
	quest.5B1153E41E67209F.quest_subtitle: "Fuel used in well-done steak | 全熟牛排使用的燃料"
	quest.5B1153E41E67209F.title: "&9Superheated Blaze Core | &9超热烈焰核心"
	quest.5B490515AAA78D05.title: "Craft Ground Rod | 合成接地棒"
	quest.5C06543962E420C4.quest_subtitle: "A &6Electric Motor&r converts &6Energy (E)&r into kinetic energy (&6SU&r) at any &6RPM&r | &6电动机&r以任意&6转速&r将&6能量 (E)&r转化为动能（&6应力量&r）"
	quest.5C251AB7110F0E5F.quest_subtitle: "&6Huge Diesel Engines&r connect to &6Shafts&r and will start generating kinetic energy once you give them some fuel | &6巨型柴油引擎&r连接到&6传动轴&r后，只要提供燃料就会开始产生动能"
	quest.5C57943A4AA32FB1.quest_subtitle: "A &6Propeller Bearing&r allows a propeller assembly to rotate and provide &6Propulsion&r while attached to a larger contraption | &6螺旋桨轴承&r允许螺旋桨组件旋转，在连接到更大装置时提供&6推进力&r"
	quest.5C583586C93CA3F7.quest_subtitle: "A similar process follows the creation of the totem's body. You simply saw and press a &6tumbaga alloy&r, and instead of potions, you deploy a &fghast tear&r to give the totem &cregenerative powers&r and then deploy a tumbaga alloy to seal it up. | 图腾之身的制作过程与之类似。你只需锯切并压制&6图巴加合金&r，与药水不同的是，你需要投出&f恶魂之泪&r为图腾赋予&c再生之力&r，然后投放图巴加合金将其封住"
	quest.5C583586C93CA3F7.title: "&2Totem of Undying Body Casing | &2不死图腾之身外壳"
	quest.5C5DE3ECE4E39C5F.quest_subtitle: "Trigger an Overstress Clutch. | 触发一个过载离合器"
	quest.5C5DE3ECE4E39C5F.title: "Circuit Breaker | 断路器"
	quest.5C61D230E8A41A99.quest_subtitle: "Essential for everything we are about to craft | 我们接下来要合成的一切都离不开它"
	quest.5C61D230E8A41A99.title: "&6Brass Sheet | &6黄铜板"
	quest.5CDDAD4D40B67D7B.quest_subtitle: "A &cPulse Extender&r extends a pulse to a configurable duration | &c脉冲延长器&r将脉冲延长到可配置的时长"
	quest.5CE78B938070D81B.title: "Bake your first Kruidnoten | 烘焙你的第一块荷式姜饼"
	quest.5D0986618729A519.quest_subtitle: "A &cSmart Observer&r can look for specific items in the world or in inventories | &c智能观察器&r可以检测世界或容器中的特定物品"
	quest.5D19586551060173.quest_subtitle: "Used to connect electrical connectors. | 用于连接电气连接器"
	quest.5DC6203AE9661C6A.quest_subtitle: "Hey, it's better than coal at least. | 嘿，至少比煤好"
	quest.5DC6203AE9661C6A.title: "&6Sticks Bundle | &6木棍捆"
	quest.5E04B024C8E9B865.quest_subtitle: "A &6Spout&r is used for filling items with fluids and crafting certain items using fluids | &6注液器&r用于向物品注入流体，以及使用流体合成特定物品"
	quest.5E85B7FE95242BBB.title: "Craft Heavily Insulated Wire Spool | 合成重度绝缘线轴"
	quest.5E89E093362958B4.quest_subtitle: "&6Honey Glue&r is a convenient alternative to &aSuper Glue&r for simulated contraptions | &6蜂蜜胶&r是&a超级胶水&r的便捷替代品，适用于模拟装置"
	quest.5EB05566545D1E5C.quest_subtitle: "A &6Train Station&r is the block that deals with train assembly and disassembly | &6列车站&r是负责列车组装与拆解的方块"
